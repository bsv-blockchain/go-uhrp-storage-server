# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Go List
go.list

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# OS files
*.db
*.DS_Store

# Jetbrains
.idea/

# Eclipse
.project

# Notes
todo.md

# Distribution
dist

# Code coverage
coverage.txt
coverage.out

# Fuzz Tests
testdata

# AI Models
.claude

# Node modules
node_modules/

# Local worktrees
.worktrees/

# Environment files (.env.example stays tracked)
.env

# Server binaries: go build ./cmd/server drops "server" in the root, and the
# documented build names it uhrp-storage-server; root-anchored so cmd/server/ stays tracked
/server
/uhrp-storage-server

# Uploaded files served from /cdn (the directory itself stays tracked)
public/cdn/*
!public/cdn/.gitkeep
