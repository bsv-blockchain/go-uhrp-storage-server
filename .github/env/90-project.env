# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-uhrp-storage-server
# Load Order: 90 (loaded after all defaults, overrides earlier files)
#
# This file contains configuration values that are specific to this project
# and override the defaults defined in earlier env files (00-core, 10-*, 20-*).
#
# Only add variables here that differ from the defaults.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Project Go versions (overrides 00-core.env defaults; matches the go directive in go.mod)
GO_PRIMARY_VERSION=1.27.x
GO_SECONDARY_VERSION=1.27.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.27.x
MAGE_X_GO_SECONDARY_VERSION=1.27.x

# ================================================================================================
# 📊 COVERAGE OVERRIDES
# ================================================================================================

# Custom Coverage Exclusions (overrides 10-coverage.env; matches codecov.yml ignore paths)
# docs/ holds the generated Swagger package, and internal/wallet/mocks/ the test doubles.
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,docs/,example/,examples/,mocks/,plans/,test/,test-client/,testing/,testdata/,vendor/

# Skip URL Checks in Coverage Reports (overrides 10-coverage.env)
GO_COVERAGE_SKIP_URL_CHECKS=true

# Coverage Provider (overrides 10-coverage.env)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (overrides 10-coverage.env)
CODECOV_TOKEN_REQUIRED=true

# ================================================================================================
# 🏗️ BUILD TAG CONFIGURATION
# ================================================================================================

# Exclude GOOS names from auto-discovered build tags to prevent conflicts in Go 1.26+.
# Using GOOS names (e.g. "windows") as custom build tags causes internal/goos redeclarations
# when running on a different OS (e.g. macOS with -tags windows).
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,windows
